+# The commit that fixes a harness-plumbing control (fork_reconciler). Its subject
+# carries "harden" and its files are infra-only -> the taxonomy calls it self-repair.
+HARDEN_OF_PLUMBING_SHA = "1333c100d1e3"
+
+
+def test_harden_of_plumbing_is_self_repair_not_product():
+    """REGRESSION: a harden of the harness's OWN plumbing must read WASTE/self-repair.
+    The pre-fix classifier had "harden" as a blanket PRODUCT keyword that short-
+    circuited before file-domain resolution, billing ~140 infra-only harden commits
+    as product -- a self-FLATTERING fail-open that inflated productive-% and deflated
+    cost-of-self-maintenance (the two headline diagnostics G11 exists to report)."""
+    commits = _resolve_commits()  # fail-closed: the sha must be in live history
+    c = commits[HARDEN_OF_PLUMBING_SHA]
+    cls, rule = classify_commit(c)
+    assert cls == SELF_REPAIR, (
+        f"harden-of-plumbing misclassified as {cls} (rule={rule}) -- self-flattering "
+        f"fail-open regressed. Subject: {c.subject[:80]}"
+    )
+    assert rule == "harden_of_plumbing"
+
+
+def test_mutation_blanket_harden_keyword_would_trip_the_gate():
+    """R15 (the control MUST be able to fail): re-introducing the fail-open -- ANY
+    'harden' subject -> product, ignoring file domain -- makes this fixture commit
+    disagree with its self-repair ground truth on the COARSE (productive/waste) axis,
+    proving the fixture entry is load-bearing and a fail-open regression cannot pass
+    silently."""
+    import re as _re
+    commits = _resolve_commits()
+
+    def blanket_harden(commit):
+        if _re.search(r"\bharden", commit.subject, _re.IGNORECASE):
+            return (PRODUCT, "mutant_blanket_harden")
+        return classify_commit(commit)
+
+    pred, _ = blanket_harden(commits[HARDEN_OF_PLUMBING_SHA])
+    truth = HAND_LABELS[HARDEN_OF_PLUMBING_SHA]
+    assert _coarse(pred) != _coarse(truth), (
+        "the pre-fix blanket-harden mutant should DISAGREE with the self-repair "
+        "ground truth on the productive/waste axis -- the gate must discriminate"
+    )
+
+
 def test_current_margins_are_reported(capsys):
