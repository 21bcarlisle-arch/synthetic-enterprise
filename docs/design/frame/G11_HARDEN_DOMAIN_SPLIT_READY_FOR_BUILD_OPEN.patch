+# HARDEN is domain-dependent, NOT a blanket product signal. This repo emits
+# hundreds of "harden(...)"/"rest-with-proof re-verify" commits that maintain the
+# HARNESS's OWN plumbing (supervisor/reconciler/hooks) -- that is WASTE/self-repair,
+# not product. Billing them PRODUCTIVE/product was a self-FLATTERING fail-open that
+# inflated productive-% and DEFLATED cost-of-self-maintenance (the metric the design
+# requires be able to trend UP as a warning). So "harden" is resolved by file domain,
+# exactly like the fix-class rule: hardening product code -> product, hardening the
+# plumbing -> self-repair, hardening a design/framing doc -> discovery, mixed ->
+# unattributed. Removed from _PRODUCT_RE; handled by its own rule after fix.
+_HARDEN_RE = re.compile(r"\bharden(?:ing|ed|s)?\b", re.IGNORECASE)
 _PRODUCT_RE = re.compile(
